# Database
DATABASE_URL="postgresql://user:password@localhost:5432/email_crm?schema=public"

# Server
PORT=3000
NODE_ENV=development

# WooCommerce Integration
WOOCOMMERCE_URL=https://your-store.com
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxx

# Email Configuration
# Escolha um provedor: sendgrid, mailgun, smtp
EMAIL_PROVIDER=sendgrid
EMAIL_FROM=seu-email@dominio.com

# SendGrid (se EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxx

# Mailgun (se EMAIL_PROVIDER=mailgun)
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxx
MAILGUN_DOMAIN=mg.seu-dominio.com

# SMTP Genérico (se EMAIL_PROVIDER=smtp)
# Funciona com Gmail, Outlook, ou qualquer servidor SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-app

# API Keys (for future use)
JWT_SECRET=your-secret-key-here
